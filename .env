# ==============================================================================
# SVERK PIKOCLAW SWARM CONFIGURATION (.env)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SVERK AI LLM NETWORK API SETTINGS (Strict Zero-Offline Mode)
# ------------------------------------------------------------------------------
SVERK_LLM_API_KEY=sk-gjmHW2rkxnYl-N0dt5nVyg
SVERK_LLM_BASE_URL=https://ai.sverk.io/v1
SVERK_LLM_MODEL=gemma4-vlm
SVERK_LLM_MAX_RETRIES=2
SVERK_LLM_TIMEOUT_S=30.0

# ------------------------------------------------------------------------------
# 2. PIKOCLAW ROS2 / HTTP BRIDGE HARDWARE GATEWAY
# ------------------------------------------------------------------------------
BRIDGE_URL=http://localhost:9000
BRIDGE_MODE=painter
BRIDGE_FRAME=aruco_map
PORT=9000
AGENT_ID=drone_black

# ------------------------------------------------------------------------------
# 3. FIELD & CANVAS GEOMETRY (ARUCO Frame Meters)
# ------------------------------------------------------------------------------
CELL_SIZE_M=0.8
FIELD_ORIGIN_X=0.0
FIELD_ORIGIN_Y=0.0
FLIGHT_ALT_M=1.5
NAV_SPEED_MS=0.5
NAV_TOLERANCE_M=0.3
NAV_TIMEOUT_S=30.0
TAKEOFF_BODY_FALLBACK=1

# ------------------------------------------------------------------------------
# 4. PIKOCLAW SPRAY SYSTEM & NOZZLE SERVO CONFIGURATION
# ------------------------------------------------------------------------------
SPRAY_ON_DEG=60
SPRAY_OFF_DEG=0
CANVAS_SCALE_M=0.025
CANVAS_ORIGIN_X=0.0
CANVAS_ORIGIN_Y=0.0
PAINT_ALT_M=1.0

# ------------------------------------------------------------------------------
# 5. VLM & ROS2 MCP INTEGRATION
# ------------------------------------------------------------------------------
ROS2_MCP_URL=http://localhost:9092
ARTIFACTS_DIR=/tmp/artifacts

# ------------------------------------------------------------------------------
# 6. SWARM FLEET & SAFETY BOUNDS (Rules & Constraints)
# ------------------------------------------------------------------------------
MIN_BATTERY_PCT=40.0
MAX_ALTITUDE_M=4.0
MAX_MISSION_TIME_S=900.0
NAMESPACES=drone_black,drone_red,drone_blue,drone_yellow
LOG_DIR=logs
